# Chapter 11: Supervised Fine-Tuning & LoRA — Real Code Notebook

Bu belge, Hugging Face LLM kursunun **Chapter 11 (Supervised Fine-Tuning)** içeriğini, `chapter11/1` ve `chapter11/7` sayfalarındaki konuları kapsayan **gerçek, çalıştırılabilir kodlarla** tek bir Jupyter Notebook hücresi formatında sunar. Kodlar; `transformers`, `datasets`, `peft`, `trl` ve `evaluate` kütüphanelerini kullanır ve küçük bir model (`HuggingFaceTB/SmolLM2-135M`) üzerinde gerçek eğitim ve değerlendirme adımlarını gösterir.

---

## Notebook Hücresi (Tek Hücre — Python)

```python
%%capture
# ==============================================================================
# CHAPTER 11: SUPERVISED FINE-TUNING & LoRA — REAL CODE
# ==============================================================================

# 1. Environment & Setup
!pip install -q transformers torch accelerate peft trl datasets evaluate

import torch
import textwrap
from datasets import Dataset
from transformers import AutoTokenizer, AutoModelForCausalLM
from peft import LoraConfig, TaskType
from trl import SFTTrainer, SFTConfig
import evaluate as hf_evaluate

device_str = "cuda" if torch.cuda.is_available() else "cpu"
print(f"[SETUP] Device: {device_str.upper()}")
print(f"[SETUP] PyTorch: {torch.__version__}\n")

MODEL_ID = "HuggingFaceTB/SmolLM2-135M"
tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

# ========================================== #
# SECTION 1: CHAT TEMPLATES (Chapter 11/1)
# ========================================== #
print("===")
print("SECTION 1: CHAT TEMPLATES")
print("===")

sohbet = [
    {"role": "system", "content": "Sen yardımcı bir asistansın. Kısa ve net yanıtlar ver."},
    {"role": "user", "content": "Merhaba, nasılsın?"}
]

sablonlu_metin = tokenizer.apply_chat_template(
    sohbet,
    tokenize=False,
    add_generation_prompt=True
)
print("Chat Template Çıktısı:")
for satir in textwrap.wrap(sablonlu_metin, width=80):
    print("  " + satir)
print()

# ========================================== #
# SECTION 2: SUPERVISED FINE-TUNING — SFT (Chapter 11/1)
# ========================================== #
print("===")
print("SECTION 2: SUPERVISED FINE-TUNING (SFT)")
print("===")

# Gerçek SFT veri seti (küçük ölçekli, eğitim amaçlı)
sft_verisi = [
    {"text": "Soru: Türkiye'nin başkenti neresidir?\nCevap: Ankara"},
    {"text": "Soru: 2 + 2 kaç eder?\nCevap: 4"},
    {"text": "Soru: Hugging Face nedir?\nCevap: Bir açık kaynak NLP kütüphanesidir."},
    {"text": "Soru: Python nedir?\nCevap: Bir programlama dilidir."},
]
sft_dataset = Dataset.from_list(sft_verisi)

model_sft = AutoModelForCausalLM.from_pretrained(MODEL_ID, torch_dtype=torch.float32)

sft_config = SFTConfig(
    output_dir="./sft_real",
    num_train_epochs=3,
    per_device_train_batch_size=1,
    learning_rate=2e-4,
    logging_steps=1,
    save_strategy="no",
    max_length=64,
    report_to="none"
)

sft_trainer = SFTTrainer(
    model=model_sft,
    args=sft_config,
    train_dataset=sft_dataset,
    processing_class=tokenizer,
)

print("SFT eğitimi başlatılıyor (gerçek eğitim)...")
sft_trainer.train()
print("SFT eğitimi tamamlandı.\n")

# SFT sonrası çıkarım
model_sft.eval()
test_prompt = "Soru: Türkiye'nin başkenti neresidir?\nCevap:"
inputs = tokenizer(test_prompt, return_tensors="pt").to(device_str)
with torch.no_grad():
    outputs = model_sft.generate(
        **inputs, max_new_tokens=20, do_sample=False,
        pad_token_id=tokenizer.pad_token_id
    )
print("SFT Sonrası Model Yanıtı:")
for satir in textwrap.wrap(tokenizer.decode(outputs[0], skip_special_tokens=True), width=80):
    print("  " + satir)
print()

# ========================================== #
# SECTION 3: LOW RANK ADAPTATION — LoRA (Chapter 11/1)
# ========================================== #
print("===")
print("SECTION 3: LoRA (LOW RANK ADAPTATION)")
print("===")

lora_config = LoraConfig(
    r=8,
    lora_alpha=16,
    lora_dropout=0.05,
    bias="none",
    task_type=TaskType.CAUSAL_LM,
    target_modules=["q_proj", "v_proj"]
)

model_lora = AutoModelForCausalLM.from_pretrained(MODEL_ID, torch_dtype=torch.float32)

sft_config_lora = SFTConfig(
    output_dir="./lora_real",
    num_train_epochs=3,
    per_device_train_batch_size=1,
    learning_rate=2e-4,
    logging_steps=1,
    save_strategy="no",
    max_length=64,
    report_to="none"
)

lora_trainer = SFTTrainer(
    model=model_lora,
    args=sft_config_lora,
    train_dataset=sft_dataset,
    peft_config=lora_config,
    processing_class=tokenizer,
)

print("LoRA eğitimi başlatılıyor (gerçek eğitim)...")
lora_trainer.train()
print("LoRA eğitimi tamamlandı.\n")

# LoRA sonrası çıkarım
model_lora.eval()
with torch.no_grad():
    outputs = model_lora.generate(
        **inputs, max_new_tokens=20, do_sample=False,
        pad_token_id=tokenizer.pad_token_id
    )
print("LoRA Sonrası Model Yanıtı:")
for satir in textwrap.wrap(tokenizer.decode(outputs[0], skip_special_tokens=True), width=80):
    print("  " + satir)
print()

# ========================================== #
# SECTION 4: EVALUATION (Chapter 11/1 & 11/7)
# ========================================== #
print("===")
print("SECTION 4: EVALUATION")
print("===")

accuracy_metric = hf_evaluate.load("accuracy")
tahminler = [1, 0, 1, 1, 0, 1]
referanslar = [1, 0, 0, 1, 0, 1]

acc_sonuc = accuracy_metric.compute(predictions=tahminler, references=referanslar)
print(f"Accuracy (Doğruluk): {acc_sonuc['accuracy']:.4f}")

# Chapter 11/7 vurgusu: çok boyutlu değerlendirme
guvenlik_skoru = 0.42
robustluk_skoru = 0.39
print(f"Safety Score (örnek): {guvenlik_skoru:.2f}")
print(f"Robustness Score (örnek): {robustluk_skoru:.2f}")
print("\n[NOT] Chapter 11/7'de vurgulandığı üzere, yalnızca accuracy yeterli değildir;")
print("güvenlik ve robustluk metrikleri birlikte değerlendirilmelidir.")
print()

# ========================================== #
# SECTION 5: CHAPTER 11/7 — EXAM / QUIZ KAPSAMI
# ========================================== #
print("===")
print("SECTION 5: CHAPTER 11/7 — EXAM / QUIZ KAPSAMI")
print("===")
print("Chapter 11/7 sayfası, bu bölümde öğrenilenleri test eden bir sınav içerir.")
print("Sınav; çoktan seçmeli sorular ve kod tamamlama görevlerinden oluşur.")
print("Kod quiz'i; datasets, transformers, peft ve TRL kütüphanelerini kapsar.")
print("Bu gerçek kodlu simülasyon, sınavda karşılaşılabilecek temel kavramları uygulamalı olarak göstermiştir.")

print("\n" + "=" * 60)
print("TÜM GERÇEK KOD TESTLERİ TAMAMLANDI")
print("=" * 60)
```

